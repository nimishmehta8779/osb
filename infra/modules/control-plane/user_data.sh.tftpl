#!/bin/bash
# Builds and runs the pinned Sovereign image on first boot.
# Files are passed base64-encoded by Terraform, so nothing needs to be fetched from outside.
set -euo pipefail

dnf install -y -q docker
systemctl enable --now docker

dnf install -y -q amazon-cloudwatch-agent
mkdir -p /opt/aws/amazon-cloudwatch-agent/etc
cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'CWAGENT'
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/lib/docker/containers/*/*-json.log",
            "log_group_name": "${log_group}",
            "log_stream_name": "{instance_id}",
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
CWAGENT
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json \
  || echo "cloudwatch agent config failed to apply; continuing without shipped logs"

mkdir -p /opt/sovereign/config /opt/sovereign/templates/1.39.2

echo "${dockerfile_b64}" | base64 -d > /opt/sovereign/Dockerfile
echo "${config_b64}" | base64 -d > /opt/sovereign/config/sovereign.yaml
echo "${listeners_b64}" | base64 -d > /opt/sovereign/templates/1.39.2/listeners.yaml.j2
echo "${clusters_b64}" | base64 -d > /opt/sovereign/templates/1.39.2/clusters.yaml.j2

cd /opt/sovereign
docker build -t osb/sovereign:0.32.12 .

docker rm -f sovereign 2>/dev/null || true
docker run -d --name sovereign --restart unless-stopped \
  -p 8080:8080 \
  osb/sovereign:0.32.12
