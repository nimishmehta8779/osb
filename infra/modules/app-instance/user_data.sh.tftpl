#!/bin/bash
# Pulls the build context from S3, builds the image, and runs it.
# Rendered by Terraform. Runs once at first boot.
set -euo pipefail

dnf install -y -q docker
systemctl enable --now docker

# CloudWatch agent: ships this container's docker JSON logs to CloudWatch Logs.
# No metrics config here -- EC2 status checks (used by the StatusCheckFailed
# alarm) come from the hypervisor, not this agent.
dnf install -y -q amazon-cloudwatch-agent
mkdir -p /opt/aws/amazon-cloudwatch-agent/etc
cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'CWAGENT'
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/lib/docker/containers/*/*-json.log",
            "log_group_name": "${log_group}",
            "log_stream_name": "{instance_id}",
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
CWAGENT
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json \
  || echo "cloudwatch agent config failed to apply; continuing without shipped logs"

dnf install -y -q unzip
mkdir -p /opt/app
aws s3 cp --region ${region} "s3://${artifact_s3_bucket}/${artifact_s3_key}" /tmp/artifact.zip
unzip -oq /tmp/artifact.zip -d /opt/app

cd /opt/app
docker build -t ${image_name} -f ${dockerfile} .

docker rm -f app 2>/dev/null || true
docker run -d --name app --restart unless-stopped \
%{ for p in ports ~}
  -p ${p.host}:${p.container} \
%{ endfor ~}
%{ for k, v in env ~}
  -e ${k}="${v}" \
%{ endfor ~}
  ${image_name}
