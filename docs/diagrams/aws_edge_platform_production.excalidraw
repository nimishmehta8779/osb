      "link": null,
      "locked": false,
      "text": "Detects HTTP failure -> logs WARNING -> enters backoff with jitter.\nLEAVES /var/lib/osb/lkg/ UNTOUCHED.\nNo unvalidated or broken config is ever written to disk.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "center",
