    {
      "id": "5fd231ec-a",
      "type": "text",
      "x": 1106.0,
      "y": 1252.0,
      "width": 314.0,
      "height": 18.0,
      "angle": 0,
      "strokeColor": "#64748B",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1000,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Envoy consumes configuration strictly via path_config_source.\nZero network lookups during request execution.\n\nRESULT:\n1. 100% of live traffic continues routing to backends.\n2. Zero packet loss during control plane outages.\n3. Complete decoupling of data plane availability\n   from control plane uptime.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 16,
      "containerId": null,
      "originalText": "Envoy consumes configuration strictly via path_config_source.\nZero network lookups during request execution.\n\nRESULT:\n1. 100% of live traffic continues routing to backends.\n2. Zero packet loss during control plane outages.\n3. Complete decoupling of data plane availability\n   from control plane uptime.",
      "lineHeight": 1.25
    },
